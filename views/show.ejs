<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= listing.title %> - CampusSwap</title>

    <link rel="stylesheet" href="/css/style.css">
</head>


<body>

    <nav class="navbar">

        <h2>CampusSwap</h2>

        <div>
            <a href="/">Home</a>
            <a href="/listings">Browse</a>
            <a href="/listings/new">Sell Item</a>
            <a href="/chatbot">🤖 AI Assistant</a>
        </div>

    </nav>


    <div class="product-container">

        <div class="product-card">


            <!-- Product Image -->

            <% if (listing.image) { %>

                <img
                    src="<%= listing.image %>"
                    alt="<%= listing.title %>"
                    class="product-image"
                >

            <% } else { %>

                <div class="product-no-image">
                    📦
                    <span>No Image Available</span>
                </div>

            <% } %>


            <!-- Product Information -->

            <h1>
                <%= listing.title %>
            </h1>

            <h2 class="product-price">
                ₹<%= listing.price %>
            </h2>


            <div class="product-details">

                <p>
                    <strong>Category:</strong>
                    <%= listing.category %>
                </p>

                <p>
                    <strong>Condition:</strong>
                    <%= listing.condition || "Not specified" %>
                </p>

                <p>
                    <strong>Description:</strong>
                    <%= listing.description %>
                </p>

            </div>


            <!-- Seller -->

            <div class="seller-box">

                <h3>Seller Information</h3>

                <p>
                    <strong>Name:</strong>
                    <%= listing.sellerName %>
                </p>


                <button
                    onclick="showContact()"
                    class="contact-btn"
                >
                    Contact Seller
                </button>
                <% if (user && listing.user && listing.user.toString() === user.id.toString()) { %>

    <a
        href="/listings/<%= listing._id %>/edit"
        class="edit-btn"
    >
        ✏️ Edit Listing
    </a>


    <form
        action="/listings/<%= listing._id %>/delete"
        method="POST"
        onsubmit="return confirm('Are you sure you want to delete this listing?');"
    >

        <button
            type="submit"
            class="delete-btn"
        >
            🗑️ Delete Listing
        </button>

    </form>

<% } %>

            </div>


            <!-- Contact popup -->

            <div
                id="contactBox"
                class="contact-box"
            >

                <h3>📞 Seller Contact</h3>

                <p>
                    <strong>Name:</strong>
                    <%= listing.sellerName %>
                </p>

                <p>
                    <strong>Contact:</strong>
                    <%= listing.sellerContact %>
                </p>

                <button
                    onclick="hideContact()"
                    class="close-btn"
                >
                    Close
                </button>

            </div>


            <a
                href="/listings"
                class="back-link"
            >
                ← Back to Listings
            </a>


        </div>

    </div>


    <script>

        function showContact() {

            document.getElementById("contactBox").style.display = "block";

        }


        function hideContact() {

            document.getElementById("contactBox").style.display = "none";

        }

    </script>

</body>

</html>