<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up - CampusSwap</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar">

        <h2>CampusSwap</h2>

        <div>
            <a href="/">Home</a>
            <a href="/listings">Browse</a>
            <a href="/listings/new">Sell Item</a>
            <a href="/chatbot">🤖 AI Assistant</a>
        </div>

    </nav>


    <section class="form-container">

        <h1>Create Account</h1>

        <p>
            Join CampusSwap and start buying and selling with students.
        </p>


        <form action="/signup" method="POST">

            <label>Name</label>

            <input
                type="text"
                name="name"
                placeholder="Enter your name"
                required
            >


            <label>Email</label>

            <input
                type="email"
                name="email"
                placeholder="Enter your email"
                required
            >


            <label>Password</label>

            <input
                type="password"
                name="password"
                placeholder="Create a password"
                required
            >


            <button type="submit">
                Create Account
            </button>

        </form>


        <p>
            Already have an account?
            <a href="/login">Login</a>
        </p>

    </section>

</body>

</html>