<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusSwap Chatbot</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <nav class="navbar">

        <h2>CampusSwap</h2>

        <div>
            <a href="/">Home</a>
            <a href="/listings">Browse</a>
            <a href="/listings/new">Sell Item</a>
        </div>

    </nav>


    <div class="chat-container">

        <h1>🤖 CampusSwap Assistant</h1>

        <p>Ask me anything about CampusSwap.</p>


        <div id="chat-box">

            <div class="bot-message">
                Hi! 👋 I'm the CampusSwap Assistant.
                How can I help you?
            </div>

        </div>


        <form id="chat-form">

            <input
                type="text"
                id="user-input"
                placeholder="Ask something..."
                required
            >

            <button type="submit">
                Send
            </button>

        </form>

    </div>


    <script src="/js/chatbot.js"></script>

</body>

</html>